<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sınıf adları değişmez (plan Bölüm 2): kullanıcının verdiği erişilebilirlik ve bildirim izni bileşen adına bağlı.
         Rawstats ile aynı bildirim; gövde Aşama 3'te. -->
    <application>

        <!-- Wolt / Bolt ekranlarını YALNIZ okur. Hiçbir yere basmaz. -->
        <service
            android:name="com.kuryelog.app.WatchService"
            android:exported="true"
            android:label="@string/watch_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <service
            android:name="com.kuryelog.app.NotifService"
            android:exported="true"
            android:label="@string/notif_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Ağsız OCR (S17, CAPTURE.md 7.3): ML Kit kullanım ölçümünü Google veri aktarımına (CCT arka ucu) verir. Arka ucun kaydı
             kaldırılır: aktarım kütüphanesi arka uç bulamaz, olayları gönderilmeden siler. Sınıflar kalır (ML Kit CCTDestination'a
             doğrudan bakar; kütüphaneyi çıkarmak OCR'ı NoClassDefFoundError ile bozar). -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

    </application>

</manifest>
