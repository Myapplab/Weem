<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sınıf adları değişmez (plan Bölüm 2): kullanıcının verdiği erişilebilirlik ve bildirim izni bileşen adına bağlı.
         Rawstats ile aynı bildirim; gövde Aşama 3'te. -->
    <application>

        <!-- Wolt / Bolt ekranlarını YALNIZ okur. Hiçbir yere basmaz. -->
        <service
            android:name="com.kuryelog.app.WatchService"
            android:exported="true"
            android:label="@string/watch_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <service
            android:name="com.kuryelog.app.NotifService"
            android:exported="true"
            android:label="@string/notif_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
