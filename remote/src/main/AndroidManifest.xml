<?xml version="1.0" encoding="utf-8"?>
<!-- :remote (REMOTE.md 1.2, 1.7): ekran paylaşımı (MediaProjection, ön plan servisi mediaProjection), onay penceresi, TCP akışı
     (yerel ağ; :link eşleşmesi). Bildirim izni :app'te. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application>
        <service
            android:name="com.kuryelog.app.remote.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name="com.kuryelog.app.remote.ConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
